# Copy to .env (local) or set in cPanel → Setup Node.js App → Environment variables.

# SQLite file. Tables are created automatically on the first request (src/server/schema.ts).
DATABASE_URL="file:./storage/dev.db"

# Optional: where uploads are stored. Defaults to ./storage. On cPanel set it to a
# folder outside the app (e.g. /home/<user>/leapliving-data/storage) so uploads
# survive redeploys.
# STORAGE_DIR="/home/<user>/leapliving-data/storage"

# First Super Admin for /admin. Used ONLY while the database has no users at all: on first
# start this account is created and must choose a new password at its first sign-in. After
# that, people are managed in /admin/users and these two values are ignored (you can remove
# them). Password: 12+ characters, must not contain the username.
# ADMIN_USER="leapadmin"
# ADMIN_PASSWORD="a-long-random-temporary-password"

# Starter content: on the very first start the current listings, projects, developers,
# reviews and page text are imported so the site looks the same, then everything is edited
# in /admin. Set to false for an empty database.
# SEED_STARTER_CONTENT="false"

# Email for form notifications (Nodemailer, SMTP). Every request is saved first and its
# email queued in the outbox (/admin/outbox). Until SMTP_HOST and MAIL_FROM are set nothing
# is sent and emails wait there; nothing is lost. Never commit real values.
# SMTP_HOST="mail.leapliving.ae"
# SMTP_PORT="465"
# SMTP_SECURE="true"          # true for port 465, leave unset for 587 (STARTTLS)
# SMTP_USER="website@leapliving.ae"
# SMTP_PASSWORD=""
# MAIL_FROM="LEAP LIVING Website <website@leapliving.ae>"
# MAIL_TO="info@leapliving.ae"  # comma-separated; defaults to the email in Site settings

# Optional: key for the hashed IP stored with each form submission (abuse tracing).
# Defaults to ADMIN_PASSWORD. Any long random string.
# IP_HASH_SECRET=""

# Public address used for canonical links, sitemap, Open Graph, JSON-LD and the links in
# account emails (confirm email, reset password).
# Defaults to https://leapliving.ae. On staging set it to the staging address.
# SITE_URL="https://staging.leapliving.ae"

# Search engines. Anything but "true" sends noindex (robots.txt Disallow: /, X-Robots-Tag,
# <meta name="robots">). Set to true ONLY on the real production domain at cut-over.
# SITE_INDEXING="true"

# Preview only: lets the site load inside an iframe (X-Frame-Options / frame-ancestors).
# Never set in production; package-cpanel.sh refuses to build with it.
# ALLOW_FRAMING="1"
