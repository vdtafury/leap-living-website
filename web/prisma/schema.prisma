datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  path         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

/// Form submissions (consultation, valuation, viewing and project requests).
/// Saved first, so nothing is lost; a CRM hand-off can read from here later.
model Inquiry {
  id        String   @id @default(cuid())
  /// CONSULTATION | VALUATION | PROPERTY_INQUIRY | PROJECT_BRIEFING
  type      String
  name      String
  email     String
  phone     String
  interest  String
  notes     String   @default("")
  /// The property or project the visitor asked about, if any.
  context   String?
  pagePath  String?
  /// NEW until someone follows it up (no admin UI yet).
  status    String   @default("NEW")
  /// SHA-256 of the client IP (abuse tracing without storing the address).
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 1: admin users, permission-based RBAC, sessions, audit log
// ---------------------------------------------------------------------------

/// Admin dashboard user. Signs in with `username`; passwords are Argon2id hashes.
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String?
  name               String
  passwordHash       String
  isActive           Boolean   @default(true)
  /// Set for the bootstrap admin and after a reset: the next sign-in must choose a new password.
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Roles are data: add a role by inserting rows, never by changing code.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  /// Shipped with the app (super_admin, editor); its permissions are re-synced on start.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String @default("")
}

model RolePermission {
  roleId       String
  permissionId String

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  @@id([userId, roleId])
  @@index([roleId])
}

/// Server-side session. `id` is the SHA-256 of the cookie token, so a database leak does not
/// hand out live sessions.
model Session {
  id         String   @id
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ipHash     String?
  userAgent  String?

  @@index([userId])
}

/// Append-only from the application's point of view (SECURITY.md §7).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  /// JSON object with non-sensitive details
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Phase 1: listings
// ---------------------------------------------------------------------------

/// A listing. Visibility comes from `publicationStatus` only (PUBLISHED and not deleted);
/// `availabilityStatus` is the commercial state and never hides or shows a listing.
model Property {
  id                 String    @id @default(cuid())
  slug               String    @unique
  referenceNumber    String    @unique
  title              String
  subtitle           String    @default("")
  /// BUY | RENT (pending O-09)
  transactionType    String
  /// RESIDENTIAL | COMMERCIAL
  segment            String    @default("RESIDENTIAL")
  /// Villa | Penthouse | Apartment | Duplex | Townhouse | Commercial
  propertyType       String
  /// DRAFT | PUBLISHED | ARCHIVED
  publicationStatus  String    @default("DRAFT")
  /// AVAILABLE | UNDER_OFFER | SOLD | RENTED | OFF_MARKET
  availabilityStatus String    @default("AVAILABLE")
  /// Badge on the card (e.g. "Private Advisory"); empty = none
  highlightLabel     String    @default("")
  featured           Boolean   @default(false)
  sortOrder          Int       @default(0)
  community          String
  emirate            String    @default("Dubai")
  price              Decimal
  currency           String    @default("AED")
  /// e.g. "/ year" for rentals
  priceFrequency     String    @default("")
  beds               Int       @default(0)
  baths              Int       @default(0)
  area               Decimal
  areaUnit           String    @default("sq ft")
  /// Ready | Off-Plan | Leasing Available
  completionStatus   String    @default("Ready")
  developer          String    @default("")
  description        String    @default("")
  /// JSON array of strings
  highlights         String    @default("[]")
  /// JSON array of { url, alt }; the first image is the cover
  images             String    @default("[]")
  permitNumber       String?
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([publicationStatus, transactionType, sortOrder])
}

/// A development (off-plan or ready). Same visibility rule as Property.
model Project {
  id                String    @id @default(cuid())
  slug              String    @unique
  referenceNumber   String    @unique
  title             String
  developer         String    @default("")
  community         String
  /// RESIDENTIAL | COMMERCIAL | MIXED-USE
  segment           String    @default("RESIDENTIAL")
  /// Off-Plan | Under Construction | Ready | free text such as "Handover 2026"
  status            String
  publicationStatus String    @default("DRAFT")
  featured          Boolean   @default(false)
  sortOrder         Int       @default(0)
  startingPrice     Decimal
  currency          String    @default("AED")
  handoverLabel     String    @default("")
  paymentPlan       String    @default("")
  unitTypes         String    @default("")
  overview          String    @default("")
  /// JSON array of { label, value }
  keyFacts          String    @default("[]")
  /// JSON array of strings
  amenities         String    @default("[]")
  /// JSON array of { url, alt }; the first image is the cover
  images            String    @default("[]")
  publishedAt       DateTime?
  deletedAt         DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publicationStatus, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 1: email outbox (persist first, send later)
// ---------------------------------------------------------------------------

model EmailOutbox {
  id            String    @id @default(cuid())
  to            String
  subject       String
  text          String
  /// PENDING | SENT | FAILED (FAILED = gave up after the maximum attempts)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  /// e.g. "Inquiry" + its id
  relatedType   String?
  relatedId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Phase 2: CMS (pages and settings as typed section documents), developers
// ---------------------------------------------------------------------------

/// One editable document: a page ("home", "about") or the global "settings". `draft` and
/// `published` hold JSON validated by the section registry (src/modules/content). The public
/// site reads `published` only; Publish copies draft -> published and writes a revision.
model ContentDocument {
  key           String    @id
  draft         String
  published     String?
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ContentRevision {
  id            String   @id @default(cuid())
  documentKey   String
  content       String
  publishedById String?
  createdAt     DateTime @default(now())

  @@index([documentKey, createdAt])
}

/// Developer logo strip on the homepage (and the developer filter list).
model Developer {
  id         String   @id @default(cuid())
  name       String   @unique
  logoUrl    String
  /// Display size in the strip, in CSS pixels (logos differ in shape)
  logoWidth  Int      @default(120)
  logoHeight Int      @default(32)
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

// ---------------------------------------------------------------------------
// Website accounts (D-40): visitors sign up, save properties/projects, see their requests.
// Kept apart from admin `User`/`Session`: a website account can never reach /admin.
// ---------------------------------------------------------------------------

/// A visitor account on the public website. Email is stored lowercased and is the sign-in name.
model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String    @default("")
  passwordHash    String
  /// Null until the link in the confirmation email is opened (the account works before that).
  emailVerifiedAt DateTime?
  /// false = deactivated by the team in /admin/customers: cannot sign in, sessions ended.
  isActive        Boolean   @default(true)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
}

/// Website-account session. `id` is the SHA-256 of the cookie token (as for admin sessions).
model CustomerSession {
  id         String   @id
  customerId String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ipHash     String?
  userAgent  String?

  @@index([customerId])
}

/// One-time link token (email confirmation, password reset). `id` is the SHA-256 of the token
/// sent by email; the token itself is never stored.
model CustomerToken {
  id         String    @id
  customerId String
  /// VERIFY_EMAIL | RESET_PASSWORD
  purpose    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, purpose])
}

/// A saved (hearted) property or project.
model Favorite {
  customerId String
  /// PROPERTY | PROJECT
  itemType   String
  /// Property.id or Project.id (stable when the slug or reference changes)
  itemId     String
  createdAt  DateTime @default(now())

  @@id([customerId, itemType, itemId])
  @@index([itemType, itemId])
}

/// Links a form request to the website account that sent it (signed-in visitors only).
model CustomerInquiry {
  inquiryId  String   @id
  customerId String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Client reviews (D-44): written from a website account, shown on the homepage only after
// the team approves them in /admin/reviews.
// ---------------------------------------------------------------------------

/// One review per website account. Writing again replaces it and it waits for approval again.
model Review {
  id           String    @id @default(cuid())
  customerId   String    @unique
  /// 1 to 5 stars
  rating       Int
  title        String
  body         String
  /// Optional line under the name, e.g. "Bought in Dubai Hills"
  role         String    @default("")
  /// man | woman: generic avatar, never a photo (D-17)
  avatar       String    @default("man")
  /// Name shown on the website, e.g. "Sara K." (from the account name)
  displayName  String
  /// PENDING | APPROVED | REJECTED
  status       String    @default("PENDING")
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, reviewedAt])
}

// ---------------------------------------------------------------------------
// Pixxi CRM integration: additive tables only (safe on existing SQLite DBs).
// ---------------------------------------------------------------------------

/// Maps a local Property or Project to its source record in Pixxi CRM.
model PixxiLink {
  /// PROPERTY | PROJECT
  entityType     String
  /// Local Property.id or Project.id
  entityId       String
  /// Pixxi CRM's external propertyId (e.g. "1003101351047")
  pixxiId        String   @unique
  /// Pixxi CRM's internal numeric id (stringified), when provided
  pixxiNumericId String?
  /// SELL | RENT | NEW
  listingType    String
  /// ACTIVE | REMOVED
  syncStatus     String   @default("ACTIVE")
  /// SHA-256 of the normalized mapped payload to skip redundant updates
  contentHash    String   @default("")
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([entityType, entityId])
  @@index([listingType, syncStatus])
}

/// Persist-first delivery queue for website leads pushed to Pixxi CRM Forms API.
model PixxiLeadOutbox {
  id              String    @id @default(cuid())
  /// Local Inquiry.id (one-to-one)
  inquiryId       String    @unique
  formId          String    @default("")
  formName        String    @default("")
  /// Pixxi listing propertyId when the enquiry came from a synced listing/project
  pixxiPropertyId String?
  /// JSON snapshot of inquiry fields prepared for POST /pixxiapi/webhook/v1/form
  payload         String
  /// PENDING | SENT | FAILED
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

/// History of Pixxi CRM catalog sync runs (manual, scheduled, or webhook-triggered).
model PixxiSyncRun {
  id         String    @id @default(cuid())
  /// MANUAL | SCHEDULED | WEBHOOK
  trigger    String
  /// RUNNING | OK | ERROR
  status     String    @default("RUNNING")
  fetched    Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  archived   Int       @default(0)
  errors     Int       @default(0)
  message    String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}
