# LEAP LIVING — environment variables (names only; never commit real values)
# On Tasjeel, set these in the cPanel "Setup Node.js App" screen, not in a committed file.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Staging must be noindex and ideally behind basic auth
APP_ENV=local            # local | staging | production
LOG_LEVEL=info

# --- Database (MySQL/MariaDB) ---
# Keep connection_limit small; check the host's max connections in Phase 0
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME?connection_limit=5"

# --- Auth / security (generate long random values; different per environment) ---
AUTH_SECRET=
PREVIEW_SECRET=          # signs short-lived draft preview links
CRON_SECRET=             # protects the jobs/outbox endpoint if cron calls HTTP

# --- Storage (absolute paths, outside the web document root in production) ---
STORAGE_ROOT=./storage
UPLOAD_MAX_MB=10

# --- Email (host SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LEAP LIVING <contact@leapliving.ae>"
MAIL_NOTIFY_TO=          # comma-separated internal recipients for new leads (see DECISIONS O-11)

# --- First admin (seed only; forced password change on first login) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
